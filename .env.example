# Backend only. Never use VITE_ for any secret.
APP_ENV=development
APP_NAME=Tutor Platform
HTTP_ADDR=127.0.0.1:8080
WEB_ORIGIN=http://127.0.0.1:5173
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGODB_DATABASE=tutor_dev
AUTH_PROVIDER=password
# Optional, development fixtures only: choose a private 15–128 character passphrase.
# SEED_PASSWORD=
PAYMENT_PROVIDER=disabled
# Set PAYMENT_PROVIDER=razorpay for explicitly labelled sandbox checkout only.
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# The first journey uses an explicitly free development trial, not a payment simulation.
TRIAL_FEE_PAISE=0
MEDIA_PROVIDER=disabled
VIDEO_PROVIDER=disabled
# All documents and introduction MP4s use authenticated Cloudinary storage.
# MEDIA_PROVIDER=cloudinary
# VIDEO_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Tests may explicitly use VIDEO_PROVIDER=disk with MEDIA_PROVIDER=disk.
MEETING_PROVIDER=disabled
# MEETING_PROVIDER=zoom
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_HOST_USER_ID=
# Development only: MEDIA_PROVIDER=disk, absolute private path outside apps/web/public.
# MEDIA_ROOT=D:/Download/Tutor/.local/private-files
# Production/staging private S3-compatible object storage:
# S3_ENDPOINT=https://region.digitaloceanspaces.com
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# Optional development scanner; without it uploads stay quarantined and cannot download.
# CLAMAV_ADDRESS=127.0.0.1:3310
