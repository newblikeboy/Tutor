# Backend only. Never use VITE_ for any secret.
APP_ENV=development
APP_NAME=Tutor Platform
HTTP_ADDR=127.0.0.1:8080
WEB_ORIGIN=http://127.0.0.1:5173
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGODB_DATABASE=tutor_dev
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
OTP_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_PROVIDER=development
PAYMENT_PROVIDER=disabled
# The first journey uses an explicitly free development trial, not a payment simulation.
TRIAL_FEE_PAISE=0
